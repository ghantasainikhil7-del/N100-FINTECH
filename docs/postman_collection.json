{
  "info": {
    "_postman_id": "n100-financial-intelligence-api-v1",
    "name": "Nifty 100 Financial Intelligence API",
    "description": "Production-grade Postman collection covering all 16 REST endpoints for the Nifty 100 platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check & Table Row Counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "List All 92 Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies?sector=Information%20Technology",
              "host": ["{{baseUrl}}"],
              "path": ["companies"],
              "query": [
                {"key": "sector", "value": "Information%20Technology", "disabled": true},
                {"key": "market_cap_category", "value": "Large Cap", "disabled": true},
                {"key": "search", "value": "TCS", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Get Company Profile (TCS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS"]
            }
          }
        },
        {
          "name": "Get Company P&L History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/pl?from_year=2019-03&to_year=2024-03",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "pl"],
              "query": [
                {"key": "from_year", "value": "2019-03"},
                {"key": "to_year", "value": "2024-03"}
              ]
            }
          }
        },
        {
          "name": "Get Company Balance Sheet History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/bs",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "bs"]
            }
          }
        },
        {
          "name": "Get Company Cash Flow History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/cashflow",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "cashflow"]
            }
          }
        },
        {
          "name": "Get Company Ratios History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/ratios?year=2024-03",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "ratios"],
              "query": [
                {"key": "year", "value": "2024-03", "disabled": true}
              ]
            }
          }
        },
        {
          "name": "Download Tearsheet PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/tearsheet",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "tearsheet"]
            }
          }
        }
      ]
    },
    {
      "name": "Screener",
      "item": [
        {
          "name": "Run Screener Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/screener?min_roe=15&max_de=1.0&min_rev_cagr_5yr=10",
              "host": ["{{baseUrl}}"],
              "path": ["screener"],
              "query": [
                {"key": "min_roe", "value": "15"},
                {"key": "max_de", "value": "1.0"},
                {"key": "min_rev_cagr_5yr", "value": "10"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sectors",
      "item": [
        {
          "name": "List All 11 Sectors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sectors",
              "host": ["{{baseUrl}}"],
              "path": ["sectors"]
            }
          }
        },
        {
          "name": "Get Sector Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sectors/Information%20Technology/companies",
              "host": ["{{baseUrl}}"],
              "path": ["sectors", "Information%20Technology", "companies"]
            }
          }
        }
      ]
    },
    {
      "name": "Peers",
      "item": [
        {
          "name": "Get Peer Group Percentiles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/peers/IT%20Services",
              "host": ["{{baseUrl}}"],
              "path": ["peers", "IT%20Services"]
            }
          }
        },
        {
          "name": "Compare Company Radar vs Peers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/peers/compare",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "peers", "compare"]
            }
          }
        }
      ]
    },
    {
      "name": "Valuation",
      "item": [
        {
          "name": "Get Historical Multiples (2019-2024)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/market-cap/TCS",
              "host": ["{{baseUrl}}"],
              "path": ["market-cap", "TCS"]
            }
          }
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Get Portfolio Distribution Statistics (P10-P90)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/portfolio/stats",
              "host": ["{{baseUrl}}"],
              "path": ["portfolio", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Get Company Documents & BSE Annual Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/TCS/documents",
              "host": ["{{baseUrl}}"],
              "path": ["companies", "TCS", "documents"]
            }
          }
        }
      ]
    }
  ]
}
